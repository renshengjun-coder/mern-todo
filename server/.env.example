DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=mern_todo
DB_NAME_TEST=mern_todo_test
DB_SSL=false

# Email reminders (optional — server must stay running)
# Mailtrap: https://mailtrap.io → inbox → SMTP → copy user/pass into SMTP_USER/SMTP_PASS
# Verify: npm run verify:smtp
REMINDER_EMAIL=
REMINDER_LEAD_MINUTES=60
REMINDER_POLL_INTERVAL_MS=60000
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=reminders@mern-todo.local
